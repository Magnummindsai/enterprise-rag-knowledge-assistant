# Copy this file to .env and fill in your values.
# Leave OPENAI_API_KEY empty to run in MOCK mode (no API calls, no cost).
OPENAI_API_KEY=

# Force mock mode even when a key is set (true/false)
MOCK_MODE=false

OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Cross-encoder reranker (HuggingFace model id).
# Set USE_CROSS_ENCODER=false to use the lightweight lexical reranker instead.
RERANKER_MODEL=BAAI/bge-reranker-base
USE_CROSS_ENCODER=true

# Retrieval tuning
TOP_K_RETRIEVE=20
TOP_K_RERANK=5
# Optional override of the reranker's relevance threshold (BGE default 0.20, lexical default 0.35)
# RELEVANCE_THRESHOLD=0.25

# Persistence. SQLite is used by default (storage/rag.db).
# To use PostgreSQL (e.g. with `docker compose --profile postgres up`):
# DATABASE_URL=postgresql+psycopg://rag:rag@postgres:5432/rag

LOG_LEVEL=INFO
